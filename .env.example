DATABASE_PROVIDER=sqlserver
SQLSERVER_TRANSPORT=odbc
SQLSERVER_SQLCMD_SERVER=lpc:localhost\SQLEXPRESS

# EF / API use ConnectionStrings__SqlServer (SqlClient). Leave the ODBC string for scripts only.
ConnectionStrings__SqlServer=Server=localhost,1433;Database=DigitalPulse;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;Connection Timeout=30

# Local web + official OAuth redirect. Google Cloud Console must allow this exact URI.
Public__WebOrigin=http://localhost:5173
Connections__RedirectUri=http://localhost:5088/v1/connections/callback

# Official OAuth. Fill to open Facebook / Google / LinkedIn login. Empty keeps Connect on the login dialog.
Connections__Google__ClientId=
Connections__Google__ClientSecret=
# Required for official Google Ads health/metrics. Campaigns are not mutated.
Connections__GoogleAds__DeveloperToken=
Connections__GoogleAds__LoginCustomerId=
Connections__Meta__ClientId=
Connections__Meta__ClientSecret=
Connections__LinkedIn__ClientId=
Connections__LinkedIn__ClientSecret=

# IndiaMART official CRM lead pull only. Profile writes stay assisted.
Connections__IndiaMART__CrmKey=

# Live Cloud API. Empty = development hold. Unofficial WhatsApp clients are out of scope.
WhatsApp__CloudApi__AccessToken=
WhatsApp__CloudApi__PhoneNumberId=
WhatsApp__CloudApi__BaseUrl=https://graph.facebook.com/v21.0/

# Live AI completions. Vector search is LocalHash on this machine either way.
Ai__OpenAi__ApiKey=
Ai__OpenAi__Model=gpt-4o-mini

# Official Razorpay orders. Invoice stays unpaid until a signed webhook confirms capture.
Billing__Razorpay__KeyId=
Billing__Razorpay__KeySecret=
Billing__Razorpay__WebhookSecret=

# Optional operations. Empty stays held on /ready. Not required for local feature testing.
Auth__Provider=DevelopmentJwt
Operations__Redis=
Operations__KeyVaultUri=
Operations__ApplicationInsightsConnectionString=
Operations__AzureBackup=
